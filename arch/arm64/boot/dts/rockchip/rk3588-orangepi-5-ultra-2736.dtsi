/* Exact DMC OPPs for the selected LPDDR5 DDR blob FSP ladder. */
&dmc_opp_table {
	/delete-node/ opp-528000000;
	/delete-node/ opp-1068000000;
	/delete-node/ opp-1560000000;
	/delete-node/ opp-2750000000;

		opp-534000000 {
			opp-supported-hw = <0xf9 0xffff>;
			opp-hz = /bits/ 64 <534000000>;
			opp-microvolt = <675000 675000 875000>,
					<725000 725000 800000>;
			opp-microvolt-L1 = <675000 675000 875000>,
					   <700000 700000 800000>;
			opp-microvolt-L2 = <675000 675000 875000>,
					   <687500 687500 800000>;
